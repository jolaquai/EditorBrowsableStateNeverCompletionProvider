<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- The Tools > Options page (GeneralOptionsPage) hosts a WPF control with real checkboxes
         via UIElementDialogPage, instead of the default property-grid (which renders bools as a
         True/False dropdown). WPF assemblies are provided by the runtime; nothing is bundled. -->
    <UseWPF>true</UseWPF>

    <!-- Single source of truth for the extension version. The VSIX manifest is stamped
         from this via the |%CurrentProject%;GetVsixVersion| token (see GetVsixVersion target
         below and source.extension.vsixmanifest), and the CI workflow derives the GitHub
         release tag from it. Bump this to ship a release. Keep it a numeric VSIX-valid
         version (2-4 dotted parts, no prerelease suffix). -->
    <Version>1.1.0</Version>

    <!-- VSIX settings -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>

    <!-- Generate the .pkgdef from OptionsPackage's registration attributes and include it in the
         VSIX. Without this the |%CurrentProject%;PkgdefProjectOutputGroup| asset token in the
         manifest does not resolve and the Tools > Options page is never registered. -->
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
  </PropertyGroup>

  <!-- Resolves the |%CurrentProject%;GetVsixVersion| token in source.extension.vsixmanifest.
       The VSSDK detokenizer invokes this target on the project and stamps its return value
       as the VSIX <Identity Version>, so the manifest version always tracks <Version> above. -->
  <Target Name="GetVsixVersion" Returns="$(Version)" />

  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />

    <!-- Referenced by <License> in source.extension.vsixmanifest; must ship in the VSIX.
         The VSSDK only gathers @(Content) items (not @(None)) for the VSIX, so move it off
         the default None glob and declare it as Content. -->
    <None Remove="LICENSE" />
    <Content Include="LICENSE">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>

    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" />

    <!-- Compile-only: VS already loads its own Roslyn (Features/Workspaces). Bundling our
         copy into the VSIX would create a duplicate assembly identity and break MEF
         composition of the completion provider, so exclude these from the runtime/VSIX. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="4.0.1" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
